{
  "Name": "abc-glue-dry-run23",
  "Description": "Minimal no-data Glue Spark job for configuration validation.",
  "Role": "arn:aws:iam::455303856855:role/iam_glue_role",
  "ExecutionProperty": {
    "MaxConcurrentRuns": 1
  },
  "Command": {
    "Name": "glueetl",
    "ScriptLocation": "s3://etl-code-dev-chitranjan/e-commerce-code/tests/abc_dry_run.py",
    "PythonVersion": "3"
  },
  "DefaultArguments": {
    "--job-language": "python",
    "--enable-continuous-cloudwatch-log": "true",
    "--enable-metrics": ""
  },
  "MaxRetries": 0,
  "Timeout": 10,
  "GlueVersion": "5.1",
  "WorkerType": "G.1X",
  "NumberOfWorkers": 2
}
